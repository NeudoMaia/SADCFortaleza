{
  "version": 2,
  "functions": {
    "api/*.py": {
      "includeFiles": "{src/**,data/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ]
}
